# ============================================================
# Firecrawl Self-Hosted — Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed.
# All values have sensible defaults for local development.
# ============================================================

# ── API Server ──────────────────────────────────────────
# Port exposed on the host (mapped to container port 3002)
PORT=3002

# ── Authentication ──────────────────────────────────────
# DB auth is disabled by default (no Supabase needed for self-host)
# USE_DB_AUTHENTICATION=false

# Admin UI key for the Bull Queue Manager at /admin/<KEY>/queues
# Change this if your instance is publicly accessible
BULL_AUTH_KEY=CHANGEME

# ── PostgreSQL ──────────────────────────────────────────
# Must match the nuq-postgres service configuration
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=firecrawl
POSTGRES_DB=firecrawl

# ── Performance Tuning ──────────────────────────────────
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# ── AI Features (optional) ──────────────────────────────
# Provide an OpenAI API key to enable JSON extract and /extract API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── Search API (optional) ───────────────────────────────
# By default /v2/search uses Google. To use SearXNG instead:
# SEARXNG_ENDPOINT=http://your.searxng.server
# SEARXNG_ENGINES=
# SEARXNG_CATEGORIES=

# ── Proxy (optional) ────────────────────────────────────
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ── Media ───────────────────────────────────────────────
# Block media resources (images, video) to save bandwidth
# BLOCK_MEDIA=false
